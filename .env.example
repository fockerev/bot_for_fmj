# Required
DISCORD_BOT_TOKEN=your_discord_bot_token
OPENAI_API_KEY=your_openai_api_key
GUILD_ID=123456789012345678

# Optional
BOT_PREFIX=/
TZ=Asia/Tokyo

# Set true only when using the OAuth xurl bridge route.
INSTALL_NODE=false

# X MCP: choose one route.
# Route 1: App-only Bearer token for read-focused tools.
X_BEARER_TOKEN=your_x_app_only_bearer_token

# Route 2: OAuth 2.0 user context for account-scoped or write tools.
X_CLIENT_ID=your_x_oauth_client_id
X_CLIENT_SECRET=your_x_oauth_client_secret
X_REDIRECT_URI=http://localhost:8080/callback
